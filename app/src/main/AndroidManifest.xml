<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para continuar a tocar com a app minimizada: -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Mostrar a notificação com os controlos (Android 13+ pede autorização) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Impedir que o telemóvel "adormeça" o Wi-Fi/CPU a meio de uma música -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MeuTubeApp"
        android:label="MeuTube"
        android:icon="@android:drawable/ic_media_play"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- singleTask: ao tocar na notificação volta à app que já está aberta,
             em vez de abrir uma segunda cópia -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- O serviço que mantém o som a tocar em segundo plano -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
